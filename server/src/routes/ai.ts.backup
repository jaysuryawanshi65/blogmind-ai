import {Router} from 'express';import {HfInference} from '@huggingface/inference';import {requireAuth} from '../middleware/auth.js';import {asyncHandler} from '../utils/asyncHandler.js';
const router=Router();router.post('/generate',requireAuth,asyncHandler(async(req,res)=>{const topic=String(req.body.topic||'').trim(),tone=String(req.body.tone||'friendly');if(topic.length<4)return res.status(400).json({message:'Enter a topic with at least 4 characters.'});if(!process.env.HF_TOKEN){return res.json({demo:true,text:`# ${topic}\n\nThis is a demo draft from BlogMind AI. Add your Hugging Face token to server/.env to enable live AI generation.\n\n## Why this matters\n\nStart by explaining the problem, who it affects, and why readers should care. Use a concrete example to make the idea relatable.\n\n## Key takeaways\n\n- Introduce the main idea clearly.\n- Break complex concepts into practical steps.\n- Finish with a useful action readers can try today.\n\n**Tone requested:** ${tone}`});}const hf=new HfInference(process.env.HF_TOKEN);const result=await hf.chatCompletion({model:process.env.HF_MODEL||'HuggingFaceH4/zephyr-7b-beta',messages:[{role:'system',content:'You are a thoughtful blog writing assistant. Produce original, accurate, structured Markdown. Do not invent citations or claim uncertain facts as true.'},{role:'user',content:`Write a useful blog draft about: ${topic}. Tone: ${tone}. Include a compelling title, introduction, clear headings, practical examples, and conclusion.`}],max_tokens:900,temperature:0.7});res.json({demo:false,text:result.choices[0]?.message?.content||''});}));export default router;
